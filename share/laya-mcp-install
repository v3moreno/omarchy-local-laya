#!/usr/bin/env bash
# laya-mcp-install — register the laya MCP proxy (and pi extension/hooks where
# those apply) with every agent. Idempotent; pass agent names to restrict.
#
# NOTE: functions run via `install_x || echo` at the bottom, which disables
# `set -e` inside their bodies — every dangerous op must handle its own
# failure explicitly with || return.
set -euo pipefail
cd "$(dirname "$0")"; HERE=$PWD
# HERE is spliced into shell hook commands, TOML and YAML below; refuse any
# path that would need quoting in one of them.
[[ $HERE =~ ^[A-Za-z0-9._/+@-]+$ ]] || { echo "laya-mcp-install: unsafe folder path '$HERE'" >&2; exit 2; }

PY=$HERE/.venv/bin/python
SRV=$HERE/laya-mcp.py
PI_EXT=$HERE/../ask-laya/pi-extension/laya.js
STATE=${OMARCHY_LOCAL_AI_STATE:-$HOME/.local/state/omarchy/local-ai}

ok()   { printf '  ok %s\n' "$1"; }
skip() { printf '  -  %s\n' "$1"; }
bad()  { printf '  !! %s\n' "$1"; }

# jwrite <file> <jq args...> — write jq output via mktemp + rename so a jq or IO
# failure never leaves a truncated config. Caller handles the nonzero return.
jwrite() {
  local f=$1; shift
  command -v jq >/dev/null || { bad "jq not installed"; return 1; }
  # mktemp: random name created O_EXCL — a planted symlink can't redirect the write
  local tmp; tmp=$(mktemp "$f.XXXXXX") || return 1
  jq "$@" "$f" >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  chmod --reference="$f" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$f"
}

# safe_copy <src> <dst> — refuse a symlink, a non-regular or foreign-owned
# destination, or an existing file that shows no sign of being ours (byte-
# identical to the source, or carrying the plugin's signature strings:
# `laya-gate`, `laya route`, `ask-laya`). A planted link must never redirect
# the copy and a foreign extension is never clobbered. mktemp+rename keeps
# the write atomic. Caller handles nonzero.
safe_copy() {
  local s=$1 f=$2
  [[ ! -L $f ]] || { bad "$f is a symlink — not overwriting"; return 1; }
  [[ ! -e $f || -f $f ]] || { bad "$f is not a regular file — not overwriting"; return 1; }
  [[ ! -e $f || -O $f ]] || { bad "$f owned by another user — not overwriting"; return 1; }
  if [[ -e $f ]] && ! cmp -s "$s" "$f" && ! grep -qE 'laya-gate|laya route|ask-laya' "$f" 2>/dev/null; then
    bad "$f is not this plugin's file — refusing to overwrite (remove it to adopt ours)"; return 1
  fi
  local tmp; tmp=$(mktemp "$f.XXXXXX") || return 1
  cp "$s" "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

# jq: append a laya-gate hook entry ({matcher?, hooks:[{type,command}]}) per
# event+matcher only where none exists — never clobber the user's hooks.
# Shared by claude and gemini, whose settings use the same hook shape.
ENSURE_JQ='
  def ensure($ev; $matcher; $mode):
    .hooks[$ev] = (.hooks[$ev] // []) +
      (if (.hooks[$ev] // []) | map(($matcher == "" or .matcher == $matcher) and
          ([.hooks[].command] | any(contains("laya-gate")))) | any
       then []
       else [({hooks: [{type: "command", command: ($g + " " + $mode)}]}
              + (if $matcher == "" then {} else {matcher: $matcher} end))]
       end);
'

# mcpjson <agent> <file> <jq path> [extra jq object] — register the stdio
# proxy under <path>.laya in a JSON config, creating the file if absent
mcpjson() {
  local a=$1 f=$2 p=$3 extra=${4:-"{}"}
  mkdir -p "$(dirname "$f")" || { bad "$a: cannot create $(dirname "$f")"; return 1; }
  [[ -e $f || -L $f ]] || echo '{}' >"$f"
  jq -e "$p.laya" "$f" >/dev/null 2>&1 && return 0
  jwrite "$f" --arg c "$PY" --arg a "$SRV" "$p.laya = ({command: \$c, args: [\$a]} + $extra)" \
    || { bad "$a: $f is not valid JSON — MCP not installed"; return 1; }
}

install_codex() {
  local f=$HOME/.codex/config.toml
  [[ -f $f ]] || { skip "codex: no $f"; return; }
  grep -q '^\[mcp_servers\.laya\]' "$f" && { skip "codex: already configured"; return; }
  [[ ! -L $f ]] || { bad "codex: $f is a symlink — not appending"; return 1; }
  cat >>"$f" <<EOF || { bad "codex: cannot write $f"; return 1; }

[mcp_servers.laya]
command = "$PY"
args = ["$SRV"]
startup_timeout_sec = 15
tool_timeout_sec = 60
EOF
  ok "codex: $f"
}

install_claude() {
  command -v claude >/dev/null || { skip "claude: not installed"; return; }
  # `claude mcp list` health-checks every server (~40s); check the config file instead
  jq -e '.mcpServers.laya' "$HOME/.claude.json" >/dev/null 2>&1 || \
    claude mcp add --scope user laya -- "$PY" "$SRV" >/dev/null 2>&1 || \
      { bad "claude: mcp add failed"; return 1; }
  local f=$HOME/.claude/settings.json
  [[ -e $f || -L $f ]] || echo '{}' >"$f"
  # append a laya-gate hook per event only where none exists — never clobber
  # hooks the user already has
  jwrite "$f" --arg g "$PY $HERE/laya-gate.py" "$ENSURE_JQ"'
    .hooks = (.hooks // {})
    # filter calls are credited after they succeed now — drop the old pre-hook
    | .hooks.PreToolUse = ((.hooks.PreToolUse // []) | map(select(
        .matcher != "mcp__laya__.*" or ([.hooks[].command] | any(contains("laya-gate")) | not))))
    | ensure("PreToolUse"; "Read"; "pretool")
    | ensure("PreToolUse"; "Bash"; "pretool")
    | ensure("PostToolUse"; "Read"; "posttool")
    | ensure("PostToolUse"; "Bash"; "posttool")
    | ensure("PostToolUse"; "mcp__laya__.*"; "posttool")
    | ensure("UserPromptSubmit"; ""; "prompt")' \
    || { bad "claude: $f is not valid JSON — hooks not installed"; return 1; }
  ok "claude: MCP + hooks in $f"
}

install_opencode() {
  local d=$HOME/.config/opencode
  local f=$d/opencode.json
  mkdir -p "$d/plugins" || { bad "opencode: cannot create $d"; return 1; }
  [[ -e $f || -L $f ]] || echo '{}' >"$f"
  jq -e '.mcp.laya' "$f" >/dev/null 2>&1 || \
    jwrite "$f" --arg c "$PY" --arg a "$SRV" \
      '.mcp.laya={type:"local",command:[$c,$a],enabled:true}' || \
      { bad "opencode: $f is not valid JSON — MCP not installed"; return 1; }
  # hard enforcement plugin (tool.execute.before/after -> laya-gate.py)
  local plug=$HERE/../ask-laya/opencode-plugin/laya.js
  if [[ -f $plug ]]; then
    safe_copy "$plug" "$d/plugins/laya.js" || { bad "opencode: plugin copy failed"; return 1; }
    ok "opencode: $f + plugins/laya.js"
  else
    ok "opencode: $f (MCP only — $plug missing)"
  fi
}

install_crush() {
  local d=$STATE/agents/crush
  local f=$d/crush/crush.json
  mkdir -p "$d/crush" || { bad "crush: cannot create $d/crush"; return 1; }
  [[ -e $f || -L $f ]] || echo '{}' >"$f"
  jq -e '.mcp.laya' "$f" >/dev/null 2>&1 && { skip "crush: already configured"; return; }
  jwrite "$f" --arg c "$PY" --arg a "$SRV" '.mcp.laya={type:"stdio",command:$c,args:[$a]}' \
    || { bad "crush: $f is not valid JSON — not installed"; return 1; }
  ok "crush: $f (re-run after each 'open' if the plugin regenerates crush.json)"
}

install_grok() {
  command -v grok >/dev/null || { skip "grok: not installed"; return; }
  GROK_HOME=$STATE/agents/grok grok mcp add laya "$PY" -- "$SRV" >/dev/null 2>&1 \
    && ok "grok: $STATE/agents/grok" \
    || bad "grok: mcp add failed (plugin fork injects it on next 'open' anyway)"
}

install_copilot() {
  local d=$HOME/.copilot
  local f=$d/mcp-config.json
  mkdir -p "$d" || { bad "copilot: cannot create $d"; return 1; }
  [[ -e $f || -L $f ]] || echo '{"mcpServers":{}}' >"$f"
  jq -e '.mcpServers.laya' "$f" >/dev/null 2>&1 && { skip "copilot: already configured"; return; }
  jwrite "$f" --arg c "$PY" --arg a "$SRV" '.mcpServers.laya={type:"stdio",command:$c,args:[$a]}' \
    || { bad "copilot: $f is not valid JSON — not installed"; return 1; }
  ok "copilot: $f"
}

install_hermes() {
  command -v hermes >/dev/null || { skip "hermes: not installed"; return; }
  hermes mcp list 2>/dev/null | grep -qi laya || \
    yes | hermes mcp add laya --command "$PY" --args "$SRV" >/dev/null 2>&1 || \
      { bad "hermes: mcp add failed"; return 1; }
  # hard enforcement via shell hooks in config.yaml; atomic write via tmp+rename.
  # exit codes: 0 wrote, 3 already configured, 1 error — set -e is off here so
  # the nonzero cases fall through to the case below.
  "$PY" - "$PY" "$HERE/laya-gate.py" "$HOME/.hermes/config.yaml" <<'PYEOF'
import os, sys, tempfile, yaml
py, gate, f = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cfg = yaml.safe_load(open(f)) or {}
except OSError:
    cfg = {}
if not isinstance(cfg, dict):
    raise SystemExit("config.yaml root is not a mapping — not touching it")
hooks = cfg.setdefault("hooks", {})
if not isinstance(hooks, dict):
    raise SystemExit("hooks section is not a mapping — not touching it")
for ev in ("pre_tool_call", "post_tool_call", "pre_llm_call"):
    v = hooks.setdefault(ev, [])
    if not isinstance(v, list):
        raise SystemExit(f"hooks.{ev} is not a list — not touching it")
before = yaml.dump(hooks, sort_keys=False)
G = f"{py} {gate}"
# hermes matchers are fullmatch regexes; MCP tools are mcp__<server>__<tool>.
# Replace our own entries wholesale so older installs migrate; others untouched.
WANT = {
    "pre_tool_call": [{"matcher": "read_file|terminal", "command": f"{G} pretool hermes", "timeout": 20}],
    "post_tool_call": [{"matcher": "read_file|terminal|mcp__laya__.*",
                        "command": f"{G} posttool hermes", "timeout": 20}],
    "pre_llm_call": [{"command": f"{G} prompt hermes", "timeout": 15}],
}
for ev, entries in WANT.items():
    hooks[ev] = [h for h in hooks[ev]
                 if not (isinstance(h, dict) and G in (h.get("command") or ""))] + entries
if yaml.dump(hooks, sort_keys=False) == before:
    raise SystemExit(3)  # nothing added — don't reformat the user's yaml
# mkstemp: random name created O_EXCL in the target dir — never follows a
# planted symlink; keep the config's mode, then rename over it atomically
fd, tmp = tempfile.mkstemp(prefix=".config.yaml.", dir=os.path.dirname(f) or ".")
try:
    with os.fdopen(fd, "w") as fh:
        fh.write(yaml.dump(cfg, sort_keys=False))
    try:
        os.chmod(tmp, os.stat(f).st_mode & 0o7777)
    except OSError:
        pass
    os.replace(tmp, f)
except BaseException:
    os.unlink(tmp)
    raise
PYEOF
  case $? in
    0) ok "hermes: MCP + hooks in ~/.hermes/config.yaml (approve them in hermes on first use)" ;;
    3) skip "hermes: hooks already configured" ;;
    *) bad "hermes: hooks not written (needs pyyaml in $PY)" ;;
  esac
}

install_gemini() {
  command -v gemini >/dev/null || [[ -d $HOME/.gemini ]] || { skip "gemini: not installed"; return; }
  local f=$HOME/.gemini/settings.json
  mcpjson gemini "$f" .mcpServers || return 1
  # gemini hooks: same entry shape as claude; MCP tools are mcp_<server>_<tool>
  jwrite "$f" --arg g "$PY $HERE/laya-gate.py" "$ENSURE_JQ"'
    .hooks = (.hooks // {})
    | ensure("BeforeTool"; "read_file|run_shell_command"; "pretool gemini")
    | ensure("AfterTool"; "read_file|run_shell_command|mcp_laya_.*"; "posttool gemini")
    | ensure("BeforeAgent"; ""; "prompt gemini")' \
    || { bad "gemini: $f is not valid JSON — hooks not installed"; return 1; }
  ok "gemini: MCP + hooks in $f"
}

install_cursor() {
  command -v cursor-agent >/dev/null || [[ -d $HOME/.cursor ]] || { skip "cursor: not installed"; return; }
  mcpjson cursor "$HOME/.cursor/mcp.json" .mcpServers || return 1
  # cursor-agent + Cursor IDE share ~/.cursor/hooks.json; our entries are
  # replaced wholesale so re-runs migrate, other hooks are untouched
  local f=$HOME/.cursor/hooks.json
  [[ -e $f || -L $f ]] || echo '{"version":1,"hooks":{}}' >"$f"
  jwrite "$f" --arg g "$PY $HERE/laya-gate.py" '
    def put($ev; $mode):
      .hooks[$ev] = ((.hooks[$ev] // []) | map(select((.command // "") | contains("laya-gate") | not)))
                    + [{command: ($g + " " + $mode + " cursor")}];
    .version = (.version // 1) | .hooks = (.hooks // {})
    | put("beforeReadFile"; "pretool") | put("beforeShellExecution"; "pretool")
    | put("postToolUse"; "posttool") | put("beforeSubmitPrompt"; "prompt")' \
    || { bad "cursor: $f is not valid JSON — hooks not installed"; return 1; }
  ok "cursor: MCP + hooks in ~/.cursor (cursor-agent and Cursor IDE)"
}

install_windsurf() {
  [[ -d $HOME/.codeium/windsurf ]] || { skip "windsurf: not installed"; return; }
  mcpjson windsurf "$HOME/.codeium/windsurf/mcp_config.json" .mcpServers || return 1
  ok "windsurf: MCP in ~/.codeium/windsurf/mcp_config.json"
}

install_zed() {
  [[ -d $HOME/.config/zed ]] || { skip "zed: not installed"; return; }
  mcpjson zed "$HOME/.config/zed/settings.json" .context_servers || return 1
  ok "zed: context server in ~/.config/zed/settings.json"
}

install_vscode() {
  [[ -d $HOME/.config/Code/User ]] || { skip "vscode: not installed"; return; }
  mcpjson vscode "$HOME/.config/Code/User/mcp.json" .servers '{type: "stdio"}' || return 1
  ok "vscode: MCP in ~/.config/Code/User/mcp.json"
}

install_omp() { install_pi "$1"; }
install_pi() {
  local a=$1 d n=0
  [[ -f $PI_EXT ]] || { skip "$a: $PI_EXT missing"; return; }
  # omarchy-managed agent dir, plus the agent's own ~/.<agent>/agent when present
  for d in "$STATE/agents/$a/extensions" "$HOME/.$a/agent/extensions"; do
    [[ $d == "$HOME/.$a/agent/extensions" && ! -d $HOME/.$a/agent ]] && continue
    mkdir -p "$d" || { bad "$a: cannot create $d"; return 1; }
    safe_copy "$PI_EXT" "$d/laya.js" || { bad "$a: extension copy failed"; return 1; }
    # the extension reads its questions from here (pi loads only .js/.ts)
    safe_copy "$HERE/shared.json" "$d/laya-shared.json" || { bad "$a: shared.json copy failed"; return 1; }
    n=$((n + 1))
  done
  ok "$a: native extension in $n dir(s) — $a has no MCP"
}

# the ask-laya skill (prompt-level rules + `ask` CLI) for every agent with a
# skills dir; symlinked so a pull of ask-laya updates it. A user's own
# ask-laya/SKILL.md that isn't our symlink is left alone.
install_skills() {
  local src=$HERE/../ask-laya/SKILL.md d n=0
  [[ -f $src ]] || { skip "skills: $src missing"; return; }
  src=$(realpath "$src")
  for d in "$HOME/.claude" "$HOME/.codex" "$HOME/.config/opencode" "$HOME/.hermes" \
           "$HOME/.agents" "$HOME/.cursor" "$HOME/.gemini" "$HOME/.codeium/windsurf" \
           "$HOME/.pi/agent" "$HOME/.omp/agent"; do
    [[ -d $d ]] || continue
    local t=$d/skills/ask-laya/SKILL.md
    [[ -e $t && ! -L $t ]] && continue
    mkdir -p "$d/skills/ask-laya" && ln -sfn "$src" "$t" && n=$((n + 1))
  done
  [[ -d $HOME/.local/bin ]] && ! [[ -e $HOME/.local/bin/ask && ! -L $HOME/.local/bin/ask ]] &&
    ln -sfn "$(realpath "$HERE/../ask-laya/bin/ask")" "$HOME/.local/bin/ask"
  ok "skills: ask-laya in $n agent skill dirs + ~/.local/bin/ask"
}

agents=("$@")
for a in "${agents[@]}"; do
  declare -F "install_$a" >/dev/null || { echo "unknown agent: $a" >&2; exit 2; }
done
wanted() { ((${#agents[@]} == 0)) || printf '%s\n' "${agents[@]}" | grep -qx "$1"; }
for a in claude codex opencode crush grok copilot hermes gemini cursor windsurf zed vscode pi omp skills; do
  wanted "$a" || continue
  "install_$a" "$a" || true   # failures already reported by bad()
done
