#!/usr/bin/env bash
# Laya decision daemon — serves POST /v1/systemone on 127.0.0.1:8123.
#
#   ./laya-serve cpu    CPU inference on :8123 (safe alongside any GPU model)
#   ./laya-serve gpu    CUDA inference on :8124 (~20 ms/decision; co-locates
#                       with the 2B model at cache_size <= 131072 on a 6 GB card)
#
# Optional laya.env in this directory can set LAYA_API_KEY (bearer auth),
# LAYA_PORT, LAYA_THREADS, LAYA_MODELS.
set -euo pipefail
cd "$(dirname "$0")"

MODE="${1:-}"
case "$MODE" in
  cpu)
    export LAYA_DEVICE=cpu LAYA_PRELOAD=1
    export LAYA_THREADS="${LAYA_THREADS:-8}" LAYA_PORT="${LAYA_PORT:-8123}"
    ;;
  gpu)
    export LAYA_DEVICE=cuda LAYA_PRELOAD=0 LAYA_PORT="${LAYA_PORT:-8124}"
    ;;
  *)
    echo "usage: $0 {cpu|gpu}" >&2
    exit 2
    ;;
esac

export LAYA_HOST="${LAYA_HOST:-127.0.0.1}"

# Loopback is reachable by every local user, so the daemon requires a bearer
# token. When neither the environment nor laya.env provides one, generate it
# into laya.env (0600) — the MCP proxy and gate read the same file from their
# own directory, so agents need no extra config.
if [[ -z ${LAYA_API_KEY:-} ]] && ! grep -qs '^ *LAYA_API_KEY *=' laya.env 2>/dev/null; then
  (umask 077; printf 'LAYA_API_KEY=%s\n' "$(head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1)" >> laya.env)
fi
[[ -f laya.env ]] && chmod 600 laya.env

# laya.env is data, not shell: read NAME=value lines by hand so a stray
# $(...) or newline is inert instead of executed, and export only LAYA_*
# names so it can never set PATH, LD_PRELOAD, PYTHONPATH or the like.
if [ -f laya.env ]; then
  while IFS='=' read -r k v || [[ -n $k ]]; do
    k=${k#"${k%%[![:space:]]*}"}  # ltrim
    k=${k%"${k##*[![:space:]]}"}  # rtrim
    [[ $k =~ ^LAYA_[A-Z0-9_]+$ ]] && export "$k=$v"
  done < laya.env
fi

exec .venv/bin/python -m serve
