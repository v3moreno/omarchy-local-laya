#!/usr/bin/env bash
# omarchy:summary=Run the laya decision daemon from a folder, on CPU or GPU, optionally at login
# omarchy:args=snapshot | start | stop | restart | mode cpu|gpu | folder <path> | autostart on|off | install | update [git] | agents [agent...] | env [LAYA_*=v] | log
#
# Backend of the Local Laya bar widget. Owns a generated systemd user unit
# (omarchy-local-laya.service) built from three persisted settings — the
# folder holding a `laya-serve` script, the mode (cpu | gpu), and an
# autostart flag that enables the unit for the user session. `snapshot`
# joins that config with `systemctl show`, a /health probe, the stats hook's
# files and GPU telemetry into the JSON the widget draws; every other verb
# rewrites the unit and acts on it.
set -euo pipefail

UNIT_NAME="omarchy-local-laya.service"
UNIT="$HOME/.config/systemd/user/$UNIT_NAME"
STATE_DIR="$HOME/.local/state/omarchy/local-laya"
CONFIG="$STATE_DIR/config.json"
STATS_FILE="$STATE_DIR/stats.json"
DEFAULT_FOLDER="$HOME/Projects/local-laya"
PLUGIN_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)

die() { echo "local-laya: $*" >&2; exit 1; }

cfg() { # cfg <path> <default> — missing file/key falls back
  local v=""
  [[ -f $CONFIG ]] && v=$(jq -r "$1 // \"\"" "$CONFIG" 2>/dev/null || true)
  [[ -n $v ]] || v="$2"
  printf '%s\n' "$v"
}

mode() { local m; m=$(cfg .mode cpu); [[ $m == gpu ]] && echo gpu || echo cpu; }
folder() { cfg .folder "$DEFAULT_FOLDER"; }
autostart() { cfg .autostart false; }
port_for() { [[ $1 == gpu ]] && echo 8124 || echo 8123; }

# LAYA_PORT in the folder's laya.env overrides the per-mode default.
port() {
  local f; f=$(folder)
  local p
  p=$(sed -n 's/^ *LAYA_PORT *= *\([0-9][0-9]*\).*/\1/p' "$f/laya.env" 2>/dev/null | head -1 || true)
  if [[ -n $p ]]; then echo "$p"; else port_for "$(mode)"; fi
}

write_config() { # write_config <mode> <folder> <autostart>
  mkdir -p "$STATE_DIR"
  jq -nc --arg mode "$1" --arg folder "$2" --argjson autostart "$3" \
    '{mode: $mode, folder: $folder, autostart: $autostart}' > "$CONFIG"
}

write_unit() { # Regenerate the unit from current config; returns its path.
  local f m as
  f=$(folder); m=$(mode); as=$(autostart)
  [[ -d $f ]] || die "folder '$f' does not exist"
  [[ -x $f/laya-serve ]] || die "'$f/laya-serve' is missing or not executable"
  mkdir -p "$HOME/.config/systemd/user"
  cat > "$UNIT" <<EOF
[Unit]
Description=Laya decision daemon (omarchy-local-laya)
After=default.target

[Service]
Type=simple
WorkingDirectory=$f
Environment=PYTHONPATH=$PLUGIN_DIR/python
Environment=LAYA_STATS_FILE=$STATS_FILE
ExecStart=$f/laya-serve $m
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  if [[ $as == true ]]; then
    systemctl --user enable "$UNIT_NAME" >/dev/null 2>&1 || true
  else
    systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
  fi
}

active() { systemctl --user is-active "$UNIT_NAME" 2>/dev/null || true; }

# PID listening on a TCP port (empty when free or owned by another user).
port_pid() { ss -H -tlnp "sport = :$1" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true; }

# A pid counts as ours when its cmdline mentions laya, or it runs from the configured laya folder
# (a `python -m serve` launched there names no laya in its argv).
is_laya_pid() {
  tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q 'laya' && return 0
  [[ $(readlink "/proc/$1/cwd" 2>/dev/null) == "$(folder)" ]]
}

# Kill a laya process squatting on our port (e.g. a manually-run laya-serve).
# Refuses to touch non-laya listeners so a foreign service is never killed.
release_port() {
  local pid; pid=$(port_pid "$(port)")
  [[ -n $pid ]] || return 0
  if is_laya_pid "$pid"; then
    kill "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      sleep 0.5
      if [[ -z $(port_pid "$(port)") ]]; then break; fi
    done
  else
    die "port $(port) is held by non-laya process $pid"
  fi
}

# Which agents already have laya wired — file checks only, no agent CLIs.
# Emits a JSON array of agent names, or null when the folder lacks the
# MCP tooling (an old install before share/ carried it).
agent_wiring() {
  local f; f=$(folder)
  [[ -f $f/laya-mcp.py && -x $f/laya-mcp-install ]] || { echo null; return; }
  local lai=${OMARCHY_LOCAL_AI_STATE:-$HOME/.local/state/omarchy/local-ai}
  local list="" a
  for a in claude codex opencode copilot hermes crush pi omp; do
    case $a in
      claude)   jq -e '.mcpServers.laya' "$HOME/.claude.json" >/dev/null 2>&1 ;;
      codex)    grep -q '^\[mcp_servers\.laya\]' "$HOME/.codex/config.toml" 2>/dev/null ;;
      opencode) jq -e '.mcp.laya' "$HOME/.config/opencode/opencode.json" >/dev/null 2>&1 ;;
      copilot)  jq -e '.mcpServers.laya' "$HOME/.copilot/mcp-config.json" >/dev/null 2>&1 ;;
      hermes)   grep -q laya "$HOME/.hermes/config.yaml" 2>/dev/null ;;
      crush)    jq -e '.mcp.laya' "$lai/agents/crush/crush/crush.json" >/dev/null 2>&1 ;;
      pi|omp)   [[ -f $lai/agents/$a/extensions/laya.js ]] ;;
    esac && list+=",\"$a\""
  done
  echo "[${list#,}]"
}

snapshot() {
  local f m as fok act sub pid enabled since uptime health pn ppid
  f=$(folder); m=$(mode); as=$(autostart)
  fok=false; [[ -d $f && -x $f/laya-serve ]] && fok=true
  act=$(active); sub=$(systemctl --user show "$UNIT_NAME" -p SubState --value 2>/dev/null || true)
  pid=$(systemctl --user show "$UNIT_NAME" -p MainPID --value 2>/dev/null || true)
  enabled=$(systemctl --user is-enabled "$UNIT_NAME" 2>/dev/null || true)
  [[ -z $enabled ]] && enabled=missing
  [[ -z $pid || $pid == "0" ]] && pid=0
  since=$(systemctl --user show "$UNIT_NAME" -p ActiveEnterTimestampMonotonic --value 2>/dev/null || true)
  uptime=0
  if [[ -n $since && $since != 0 ]]; then
    uptime=$(awk -v s="$since" '{printf "%d", $1 - s/1000000}' /proc/uptime 2>/dev/null || echo 0)
    (( uptime < 0 )) && uptime=0
  fi
  pn=$(port)
  ppid=$(port_pid "$pn"); ppid=${ppid:-0}
  foreign=false
  [[ $ppid != 0 && $ppid != "$pid" ]] && foreign=true
  health=null
  if [[ $act == active || $ppid != 0 ]]; then
    health=$(curl -fsS -m 2 "http://127.0.0.1:$pn/health" 2>/dev/null || echo null)
    [[ -z $health ]] && health=null
  fi
  stats=null
  [[ -f $STATS_FILE ]] && stats=$(cat "$STATS_FILE" 2>/dev/null || echo null)
  [[ -z $stats ]] && stats=null
  days=null
  [[ -f $STATE_DIR/days.json ]] && days=$(cat "$STATE_DIR/days.json" 2>/dev/null || echo null)
  [[ -z $days ]] && days=null
  # GPU telemetry for the widget's GPUS section (any GPU, either laya mode)
  gpu=null
  if command -v nvidia-smi >/dev/null 2>&1; then
    local gname gused gtot gtemp gutil
    IFS=',' read -r gname gused gtot gtemp gutil <<< \
      "$(nvidia-smi --query-gpu=name,memory.used,memory.total,temperature.gpu,utilization.gpu \
         --format=csv,noheader,nounits 2>/dev/null | head -1)"
    if [[ -n $gname ]]; then
      gpu=$(jq -nc --arg n "${gname# }" --argjson u "${gused// /}" --argjson t "${gtot// /}" \
        --argjson c "${gtemp// /}" --argjson p "${gutil// /}" \
        '{name: $n, usedMiB: $u, totalMiB: $t, tempC: $c, utilPct: $p}' 2>/dev/null || echo null)
    fi
  fi
  version=$(jq -r '.version // ""' "$PLUGIN_DIR/manifest.json" 2>/dev/null || true)
  # installed laya package version, read from dist-info (no python spawn)
  local lver=""
  local meta; meta=$(find "$f/.venv/lib" -maxdepth 4 -name "METADATA" -path "*laya-*.dist-info*" 2>/dev/null | head -1)
  [[ -n $meta ]] && lver=$(sed -n 's/^Version: *//p' "$meta" | head -1)
  # effective laya.env tuning, as a JSON map the widget can show
  local envs="{}"
  if [[ -f $f/laya.env ]]; then
    envs=$(sed -n 's/^ *\(LAYA_[A-Z_]*\) *=\(.*\)/\1\t\2/p' "$f/laya.env" 2>/dev/null \
      | jq -Rn '[inputs | split("\t") | {key: (.[0] | sub(" *$"; "")), value: .[1]}]
                | from_entries' 2>/dev/null || echo '{}')
    [[ -z $envs || $envs == null ]] && envs="{}"
  fi
  jq -nc --arg folder "$f" --arg mode "$m" --arg sub "${sub:-unknown}" \
    --arg active "${act:-inactive}" --arg enabled "$enabled" \
    --argjson autostart "$as" --argjson folderOk "$fok" \
    --argjson pid "$pid" --argjson uptime "$uptime" --argjson port "$pn" \
    --argjson health "$health" --argjson portPid "$ppid" --argjson foreign "$foreign" \
    --argjson stats "$stats" --argjson days "$days" --argjson gpu "$gpu" \
    --arg version "$version" --arg layaVersion "$lver" \
    --argjson envs "$envs" --argjson agents "$(agent_wiring)" \
    '{version: $version, layaVersion: $layaVersion, env: $envs,
      installed: ($layaVersion != ""), agents: $agents,
      folder: $folder, folderOk: $folderOk, mode: $mode,
      autostart: $autostart, active: $active, sub: $sub, pid: $pid,
      enabled: $enabled, port: $port, portPid: $portPid, foreign: $foreign,
      uptime: $uptime, health: $health, stats: $stats, days: $days,
      gpu: $gpu, running: ($active == "active")}'
}

cmd_mode() {
  [[ ${1:-} == cpu || ${1:-} == gpu ]] || die "mode cpu|gpu"
  write_config "$1" "$(folder)" "$(autostart)"
  write_unit
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

cmd_folder() {
  [[ -n ${1:-} ]] || die "folder <path>"
  local f; f=$(realpath -e "$1" 2>/dev/null) || die "'$1' does not exist"
  [[ -x $f/laya-serve ]] || die "'$f/laya-serve' is missing or not executable"
  write_config "$(mode)" "$f" "$(autostart)"
  write_unit
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

cmd_autostart() {
  [[ ${1:-} == on || ${1:-} == off ]] || die "autostart on|off"
  local as=false; [[ $1 == on ]] && as=true
  write_config "$(mode)" "$(folder)" "$as"
  write_unit  # applies enable/disable
}

cmd_start() {
  write_unit  # also validates the folder
  release_port
  rm -f "$STATS_FILE"  # fresh session counters
  systemctl --user start "$UNIT_NAME"
}

cmd_stop() {
  systemctl --user stop "$UNIT_NAME" || true
  release_port
}

# The tooling the daemon + agents need, shipped in the plugin's share/:
# the launcher, the extended HTTP server, the MCP stdio proxy, the hook
# engine, and the per-agent installer. Only files missing from the folder
# are copied — a real checkout or a user's edits are never clobbered.
sync_tools() {
  local f=$1 s
  for s in laya-serve serve.py laya-mcp.py laya-gate.py laya-mcp-install; do
    [[ -e $f/$s ]] || install -m755 "$PLUGIN_DIR/share/$s" "$f/$s" || die "could not copy $s into $f"
  done
}

# Bootstrap laya into the configured folder: venv + laya[serve] + mcp + the
# laya-serve script and MCP tooling this unit expects. `uv` when present,
# pip otherwise.
cmd_install() {
  local f; f=$(folder)
  mkdir -p "$f"
  if [[ ! -x $f/.venv/bin/python ]]; then
    if command -v uv >/dev/null 2>&1; then
      (cd "$f" && uv venv .venv) || die "venv creation failed"
    else
      python3 -m venv "$f/.venv" || die "venv creation failed"
    fi
  fi
  if command -v uv >/dev/null 2>&1; then
    uv pip install --python "$f/.venv/bin/python" "laya[serve]" mcp || die "laya install failed"
  else
    "$f/.venv/bin/pip" install --upgrade "laya[serve]" mcp || die "laya install failed"
  fi
  sync_tools "$f"
  write_config "$(mode)" "$f" "$(autostart)"
  write_unit
  local after; after=$(laya_version "$f")
  echo "local-laya: installed laya ${after:-?} into $f"
}

# Wire the laya MCP proxy + hooks into every installed agent. The folder's
# laya-mcp-install does the real work (idempotent); its report is kept in
# agents.txt so the widget can show what ran last.
cmd_agents() {
  local f; f=$(folder)
  [[ -x $f/laya-mcp-install ]] || die "'$f/laya-mcp-install' is missing — run 'install' or sync the tooling"
  (cd "$f" && ./laya-mcp-install "$@") 2>&1 | tee "$STATE_DIR/agents.txt"
}

# Upgrade the laya package inside the folder's venv. `update` tracks PyPI —
# `uv sync` when the folder is a uv project, `uv pip`/`pip` when it is a bare
# venv from `install`; `update git` installs upstream main.
cmd_update() {
  local f; f=$(folder)
  [[ -d $f ]] || die "folder '$f' does not exist — run 'install' first"
  local before; before=$(laya_version "$f")
  if [[ ${1:-} == git ]]; then
    (cd "$f" && uv pip install --python .venv/bin/python \
      "git+https://github.com/NandhaKishorM/laya") || die "git install failed"
  elif [[ -f $f/pyproject.toml ]]; then
    (cd "$f" && uv sync --upgrade-package laya) || die "uv sync failed"
  elif command -v uv >/dev/null 2>&1; then
    uv pip install --python "$f/.venv/bin/python" --upgrade "laya[serve]" || die "upgrade failed"
  else
    "$f/.venv/bin/pip" install --upgrade "laya[serve]" || die "upgrade failed"
  fi
  # The MCP proxy needs `mcp` in the venv; project syncs don't pull it in
  # unless the folder declares it. Folders installed before share/ carried
  # the MCP tooling also get the new scripts here.
  if [[ -x $f/.venv/bin/python ]]; then
    "$f/.venv/bin/python" -c 'import mcp' 2>/dev/null \
      || uv pip install --python "$f/.venv/bin/python" mcp 2>/dev/null \
      || "$f/.venv/bin/pip" install mcp 2>/dev/null || true
  fi
  sync_tools "$f"
  local after; after=$(laya_version "$f")
  echo "local-laya: laya ${before:-?} -> ${after:-?}"
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

# laya version from the folder's venv metadata — no python spawn
laya_version() {
  local meta; meta=$(find "$1/.venv/lib" -maxdepth 4 -name "METADATA" \
    -path "*laya-*.dist-info*" 2>/dev/null | head -1)
  [[ -n $meta ]] && sed -n 's/^Version: *//p' "$meta" | head -1
}

# get/set a LAYA_* key in <folder>/laya.env
cmd_env() {
  local f; f=$(folder)
  local envf="$f/laya.env"
  if [[ -z ${1:-} ]]; then
    [[ -f $envf ]] && cat "$envf" || true
    return 0
  fi
  if [[ $1 == *=* ]]; then
    local key="${1%%=*}" val="${1#*=}"
    [[ $key =~ ^LAYA_[A-Z_]+$ ]] || die "env key must be LAYA_*"
    touch "$envf"
    if grep -q "^ *${key}=" "$envf"; then
      sed -i "s|^ *${key}=.*|${key}=${val}|" "$envf"
    else
      echo "${key}=${val}" >> "$envf"
    fi
    echo "local-laya: $key=$val (applies on next start)"
    if [[ $(active) == active ]]; then
      echo "local-laya: restarting to apply"
      systemctl --user restart "$UNIT_NAME"
    fi
    return 0
  fi
  # bare key: print current value
  grep -oP "^ *${1}=\K.*" "$envf" 2>/dev/null || true
}

case "${1:-}" in
  snapshot)  snapshot ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   write_unit; release_port; systemctl --user restart "$UNIT_NAME" ;;
  mode)      cmd_mode "${2:-}" ;;
  folder)    cmd_folder "${2:-}" ;;
  autostart) cmd_autostart "${2:-}" ;;
  update)    cmd_update "${2:-}" ;;
  install)   cmd_install ;;
  agents)    shift; cmd_agents "$@" ;;
  env)       shift; cmd_env "$@" ;;
  log)       exec omarchy-launch-tui --app-id=org.omarchy.local-laya-log \
               journalctl --user -fu "$UNIT_NAME" ;;
  *)         die "snapshot | start | stop | restart | mode cpu|gpu | folder <path> | autostart on|off | install | update [git] | agents [agent...] | env [LAYA_*=v] | log" ;;
esac
