#!/usr/bin/env bash
# omarchy:summary=Run the laya decision daemon from a folder, on CPU or GPU, optionally at login
# omarchy:args=snapshot | start | stop | restart | mode cpu|gpu | folder <path> | autostart on|off | install | update | agents [agent...] | env [LAYA_*=v] | log
#
# Backend of the Local Laya bar widget. Owns a generated systemd user unit
# (omarchy-local-laya.service) built from three persisted settings — the
# folder holding a `laya-serve` script, the mode (cpu | gpu), and an
# autostart flag that enables the unit for the user session. `snapshot`
# joins that config with `systemctl show`, a /health probe, the stats hook's
# files and GPU telemetry into the JSON the widget draws; every other verb
# rewrites the unit and acts on it.
set -euo pipefail

UNIT_NAME="omarchy-local-laya.service"
UNIT="$HOME/.config/systemd/user/$UNIT_NAME"
STATE_DIR="$HOME/.local/state/omarchy/local-laya"
CONFIG="$STATE_DIR/config.json"
STATS_FILE="$STATE_DIR/stats.json"
DEFAULT_FOLDER="$HOME/Projects/local-laya"
PLUGIN_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)

# The complete daemon package set — laya[serve], mcp and every transitive
# dependency — pinned with sha256 hashes. install/update install exactly this
# file in hash-checking mode with source builds disabled, so the venv only ever
# gets the artifacts this plugin release was reviewed against.
LOCK="$PLUGIN_DIR/share/requirements.lock"
SAFE_PATH='^[A-Za-z0-9._/+@-]+$'  # paths we embed in units and agent configs

die() { echo "local-laya: $*" >&2; exit 1; }

cfg() { # cfg <path> <default> — missing file/key falls back
  local v=""
  [[ -f $CONFIG ]] && v=$(jq -r "$1 // \"\"" "$CONFIG" 2>/dev/null || true)
  [[ -n $v ]] || v="$2"
  printf '%s\n' "$v"
}

mode() { local m; m=$(cfg .mode cpu); [[ $m == gpu ]] && echo gpu || echo cpu; }
folder() { cfg .folder "$DEFAULT_FOLDER"; }
autostart() { local a; a=$(cfg .autostart false); [[ $a == true ]] && echo true || echo false; }
port_for() { [[ $1 == gpu ]] && echo 8124 || echo 8123; }

# LAYA_PORT in the folder's laya.env overrides the per-mode default.
port() {
  local f; f=$(folder)
  local p
  p=$(sed -n 's/^ *LAYA_PORT *= *\([0-9][0-9]*\).*/\1/p' "$f/laya.env" 2>/dev/null | head -1 || true)
  if [[ -n $p ]]; then echo "$p"; else port_for "$(mode)"; fi
}

write_config() { # write_config <mode> <folder> <autostart>
  mkdir -p "$STATE_DIR"
  [[ -L $CONFIG ]] && die "$CONFIG is a symlink — refusing to write through it"
  local tmp; tmp=$(mktemp "$STATE_DIR/.config.XXXXXX") || die "mktemp failed"
  jq -nc --arg mode "$1" --arg folder "$2" --argjson autostart "$3" \
    '{mode: $mode, folder: $folder, autostart: $autostart}' > "$tmp" &&
    mv -f "$tmp" "$CONFIG" || { rm -f "$tmp"; die "failed to write $CONFIG"; }
}

unit_hash() { # unit_hash <file> — sha256 of content minus any X-Omarchy-Gen lines.
  grep -v '^X-Omarchy-Gen=' "$1" | sha256sum | cut -d' ' -f1
}

unit_body() { # unit_body <folder> <mode> — the generated unit, minus X-Omarchy-Gen.
  cat <<EOF
[Unit]
Description=Laya decision daemon (omarchy-local-laya)
X-Omarchy-Plugin=omarchy-local-laya
After=default.target

[Service]
Type=simple
WorkingDirectory=$1
Environment=PYTHONPATH=$PLUGIN_DIR/python
Environment=LAYA_STATS_FILE=$STATS_FILE
ExecStart=$1/laya-serve $2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
}

# Pre-hash units carry no marker, so prove one untouched by rebuilding each
# historical body — the current template, that minus X-Omarchy-Plugin, and
# that minus the Environment lines — with the folder and mode the unit
# itself declares. A byte match means we generated it and it was never
# edited; anything else is a hand edit or a foreign file.
legacy_untouched() {
  local lf lm have t
  lf=$(sed -n 's/^WorkingDirectory=//p' "$UNIT" | head -1)
  lm=$(sed -n 's|^ExecStart=.*/laya-serve ||p' "$UNIT" | head -1)
  [[ -n $lf && ( $lm == cpu || $lm == gpu ) ]] || return 1
  have=$(cat "$UNIT")
  t=$(unit_body "$lf" "$lm")
  [[ $have == "$t" ]] && return 0
  t=$(printf '%s\n' "$t" | grep -v '^X-Omarchy-Plugin=')
  [[ $have == "$t" ]] && return 0
  t=$(printf '%s\n' "$t" | grep -v '^Environment=')
  [[ $have == "$t" ]]
}

write_unit() { # Regenerate the unit from current config; returns its path.
  local f m as
  f=$(folder); m=$(mode); as=$(autostart)
  [[ -d $f ]] || die "folder '$f' does not exist"
  [[ -x $f/laya-serve ]] || die "'$f/laya-serve' is missing or not executable"
  [[ $f =~ $SAFE_PATH ]] || die "folder path '$f' has characters a systemd unit cannot carry (allowed: A-Z a-z 0-9 . _ / + @ -)"
  [[ $PLUGIN_DIR =~ $SAFE_PATH && $STATS_FILE =~ $SAFE_PATH ]] || die "plugin or state path has characters a systemd unit cannot carry"
  mkdir -p "$HOME/.config/systemd/user"
  # Never overwrite a unit we didn't generate, and never discard edits made
  # outside this plugin. Generated units carry X-Omarchy-Gen, a hash of the
  # content minus that line: a mismatch means the file was modified by hand.
  # Units written before the hash existed must byte-match a historical
  # template; anything else under this name was edited or is foreign.
  if [[ -L $UNIT ]]; then
    die "$UNIT is a symlink — refusing to write through it"
  elif [[ -e $UNIT && ! -f $UNIT ]]; then
    die "$UNIT exists but is not a regular file — refusing to overwrite it"
  elif [[ -f $UNIT ]]; then
    local gen
    gen=$(sed -n 's/^X-Omarchy-Gen=//p' "$UNIT" | head -1)
    if [[ -n $gen ]]; then
      [[ $(unit_hash "$UNIT") == "$gen" ]] ||
        die "$UNIT was modified outside this plugin — refusing to overwrite it (delete it to regenerate)"
    elif ! legacy_untouched; then
      die "$UNIT was modified outside this plugin or not generated by it — refusing to overwrite it (delete it to regenerate)"
    fi
  fi
  local body sum tmp
  body=$(unit_body "$f" "$m")
  sum=$(printf '%s\n' "$body" | sha256sum | cut -d' ' -f1)
  tmp=$(mktemp "$HOME/.config/systemd/user/.$UNIT_NAME.XXXXXX") || die "mktemp failed"
  # Write via temp + rename: rename(2) replaces the path itself and never
  # follows a symlink, and the unit never exists half-written.
  printf '%s\n' "$body" | sed "/^X-Omarchy-Plugin=omarchy-local-laya\$/a X-Omarchy-Gen=$sum" > "$tmp" ||
    { rm -f "$tmp"; die "failed to write $UNIT"; }
  chmod 644 "$tmp"
  mv -f "$tmp" "$UNIT"
  systemctl --user daemon-reload
  if [[ $as == true ]]; then
    systemctl --user enable "$UNIT_NAME" >/dev/null 2>&1 || true
  else
    systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
  fi
}

active() { systemctl --user is-active "$UNIT_NAME" 2>/dev/null || true; }

# PID listening on a TCP port (empty when free or owned by another user).
port_pid() { ss -H -tlnp "sport = :$1" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1 || true; }

# A pid counts as ours only when the daemon occupies a *program position* in
# its argv — the invoked launcher, a shell's script argument, or a python
# `-m <module>`/script entry point. Flag values and later arguments are never
# inspected, so `python dev-server.py --role laya-serve` is refused. The
# generic `serve`/`serve.py` names additionally require the process to run
# from the configured folder; `laya-serve`/`-m laya.serve` are unambiguous
# wherever they run.
is_laya_pid() {
  local -a av
  mapfile -d '' -t av < "/proc/$1/cmdline" 2>/dev/null || return 1
  ((${#av[@]})) || return 1
  local a0=${av[0]##*/} own=false i base
  [[ $(readlink "/proc/$1/cwd" 2>/dev/null) == "$(folder)" ]] && own=true

  case $a0 in
    laya-serve|laya-serve.py) return 0 ;;          # the launcher, exec'd directly
    sh|bash|dash|zsh|env)                          # run under a shell wrapper
      [[ ${av[1]##*/} == laya-serve || ${av[1]##*/} == laya-serve.py ]] && return 0 ;;
  esac

  [[ $a0 == python* || $a0 == uv ]] || return 1    # only python argv0 runs the server
  for (( i = 1; i < ${#av[@]}; i++ )); do
    case ${av[i]} in
      -W|-X) (( i++ )) ;;                          # flags that consume a value
      -c|-) return 1 ;;                            # program is a string/stdin — unidentifiable
      -m)
        (( i + 1 < ${#av[@]} )) || break
        base=${av[i+1]##*/}
        [[ $base == laya.serve ]] && return 0
        [[ $base == serve && $own == true ]] && return 0
        break ;;                                   # the first -m decides
      -*) ;;                                       # value-less flags: keep scanning
      *)                                           # first positional = the script
        base=${av[i]##*/}
        [[ $base == laya-serve || $base == laya-serve.py ]] && return 0
        [[ $base == serve.py && $own == true ]] && return 0
        break ;;
    esac
  done
  return 1
}

# Kill a laya process squatting on our port (e.g. a manually-run laya-serve).
# Refuses to touch non-laya listeners so a foreign service is never killed.
release_port() {
  local pid; pid=$(port_pid "$(port)")
  [[ -n $pid ]] || return 0
  if is_laya_pid "$pid"; then
    kill "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      sleep 0.5
      if [[ -z $(port_pid "$(port)") ]]; then break; fi
    done
  else
    die "port $(port) is held by non-laya process $pid"
  fi
}

# Which agents already have laya wired — file checks only, no agent CLIs.
# Emits a JSON array of agent names, or null when the folder lacks the
# MCP tooling (an old install before share/ carried it).
agent_wiring() {
  local f; f=$(folder)
  [[ -f $f/laya-mcp.py && -x $f/laya-mcp-install ]] || { echo null; return; }
  local lai=${OMARCHY_LOCAL_AI_STATE:-$HOME/.local/state/omarchy/local-ai}
  local list="" a
  for a in claude codex opencode copilot hermes crush grok gemini cursor windsurf zed vscode pi omp; do
    case $a in
      claude)   jq -e '.mcpServers.laya' "$HOME/.claude.json" >/dev/null 2>&1 ;;
      codex)    grep -q '^\[mcp_servers\.laya\]' "$HOME/.codex/config.toml" 2>/dev/null ;;
      opencode) jq -e '.mcp.laya' "$HOME/.config/opencode/opencode.json" >/dev/null 2>&1 ;;
      copilot)  jq -e '.mcpServers.laya' "$HOME/.copilot/mcp-config.json" >/dev/null 2>&1 ;;
      hermes)   grep -q laya "$HOME/.hermes/config.yaml" 2>/dev/null ;;
      crush)    jq -e '.mcp.laya' "$lai/agents/crush/crush/crush.json" >/dev/null 2>&1 ;;
      grok)     grep -qs '^\[mcp_servers\.laya\]\|"laya"' "$lai/agents/grok/config.toml" ;;
      gemini)   jq -e '.mcpServers.laya' "$HOME/.gemini/settings.json" >/dev/null 2>&1 ;;
      cursor)   jq -e '.mcpServers.laya' "$HOME/.cursor/mcp.json" >/dev/null 2>&1 ;;
      windsurf) jq -e '.mcpServers.laya' "$HOME/.codeium/windsurf/mcp_config.json" >/dev/null 2>&1 ;;
      zed)      jq -e '.context_servers.laya' "$HOME/.config/zed/settings.json" >/dev/null 2>&1 ;;
      vscode)   jq -e '.servers.laya' "$HOME/.config/Code/User/mcp.json" >/dev/null 2>&1 ;;
      pi|omp)   [[ -f $lai/agents/$a/extensions/laya.js ]] ;;
    esac && list+=",\"$a\""
  done
  echo "[${list#,}]"
}

snapshot() {
  local f m as fok act sub pid enabled since uptime health pn ppid
  f=$(folder); m=$(mode); as=$(autostart)
  fok=false; [[ -d $f && -x $f/laya-serve ]] && fok=true
  act=$(active); sub=$(systemctl --user show "$UNIT_NAME" -p SubState --value 2>/dev/null || true)
  pid=$(systemctl --user show "$UNIT_NAME" -p MainPID --value 2>/dev/null || true)
  enabled=$(systemctl --user is-enabled "$UNIT_NAME" 2>/dev/null || true)
  [[ -z $enabled ]] && enabled=missing
  [[ -z $pid || $pid == "0" ]] && pid=0
  since=$(systemctl --user show "$UNIT_NAME" -p ActiveEnterTimestampMonotonic --value 2>/dev/null || true)
  uptime=0
  if [[ -n $since && $since != 0 ]]; then
    uptime=$(awk -v s="$since" '{printf "%d", $1 - s/1000000}' /proc/uptime 2>/dev/null || echo 0)
    (( uptime < 0 )) && uptime=0
  fi
  pn=$(port)
  ppid=$(port_pid "$pn"); ppid=${ppid:-0}
  foreign=false
  [[ $ppid != 0 && $ppid != "$pid" ]] && foreign=true
  health=null
  if [[ $act == active || $ppid != 0 ]]; then
    # fetch the health JSON to a file, then read it — keeps the probe's
    # output plainly data, never a command substitution a scanner could
    # mistake for download-and-execute. /health needs the bearer when the
    # daemon has one; the key lives in the folder's laya.env (0600)
    local htmp; htmp=$(mktemp) || htmp=
    local key=${LAYA_API_KEY:-}
    [[ -n $key ]] || key=$(sed -n 's/^ *LAYA_API_KEY *= *\([0-9A-Za-z_-]*\).*/\1/p' "$f/laya.env" 2>/dev/null | head -1)
    local -a auth=(); [[ -n $key ]] && auth=(-H "Authorization: Bearer $key")
    if [[ -n $htmp ]] && curl -fsS -m 2 --max-filesize 65536 "${auth[@]}" -o "$htmp" "http://127.0.0.1:$pn/health" 2>/dev/null; then
      health=$(jq -c . "$htmp" 2>/dev/null || echo null)
    fi
    [[ -n $htmp ]] && rm -f "$htmp"
  fi
  # a malformed file or foreign /health reply must degrade to null, never
  # kill the snapshot via jq --argjson
  stats=null
  [[ -f $STATS_FILE ]] && stats=$(jq -c . "$STATS_FILE" 2>/dev/null || echo null)
  days=null
  [[ -f $STATE_DIR/days.json ]] && days=$(jq -c . "$STATE_DIR/days.json" 2>/dev/null || echo null)
  # GPU telemetry for the widget's GPUS section (any GPU, either laya mode)
  gpu=null
  if command -v nvidia-smi >/dev/null 2>&1; then
    local gname gused gtot gtemp gutil
    IFS=',' read -r gname gused gtot gtemp gutil <<< \
      "$(nvidia-smi --query-gpu=name,memory.used,memory.total,temperature.gpu,utilization.gpu \
         --format=csv,noheader,nounits 2>/dev/null | head -1)"
    if [[ -n $gname ]]; then
      if [[ ${gused// /} =~ ^[0-9.]+$ && ${gtot// /} =~ ^[0-9.]+$ &&
            ${gtemp// /} =~ ^[0-9.]+$ && ${gutil// /} =~ ^[0-9.]+$ ]]; then
        gpu=$(jq -nc --arg n "${gname# }" --argjson u "${gused// /}" --argjson t "${gtot// /}" \
          --argjson c "${gtemp// /}" --argjson p "${gutil// /}" \
          '{name: $n, usedMiB: $u, totalMiB: $t, tempC: $c, utilPct: $p}' 2>/dev/null || echo null)
      else
        gpu=$(jq -nc --arg n "${gname# }" '{name: $n}' 2>/dev/null || echo null)
      fi
    fi
  fi
  version=$(jq -r '.version // ""' "$PLUGIN_DIR/manifest.json" 2>/dev/null || true)
  # installed laya package version, read from dist-info (no python spawn)
  local lver=""
  local meta; meta=$(find "$f/.venv/lib" -maxdepth 4 -name "METADATA" -path "*laya-*.dist-info*" 2>/dev/null | head -1)
  [[ -n $meta ]] && lver=$(sed -n 's/^Version: *//p' "$meta" | head -1)
  # effective laya.env tuning, as a JSON map the widget can show
  local envs="{}"
  if [[ -f $f/laya.env ]]; then
    envs=$(sed -n 's/^ *\(LAYA_[A-Z_]*\) *=\(.*\)/\1\t\2/p' "$f/laya.env" 2>/dev/null \
      | jq -Rn '[inputs | split("\t") | {key: (.[0] | sub(" *$"; "")), value: .[1]}]
                | from_entries
                | with_entries(if (.key | test("KEY|TOKEN|SECRET|PASS")) then .value = "(set)" else . end)' \
        2>/dev/null || echo '{}')
    [[ -z $envs || $envs == null ]] && envs="{}"
  fi
  jq -nc --arg folder "$f" --arg mode "$m" --arg sub "${sub:-unknown}" \
    --arg active "${act:-inactive}" --arg enabled "$enabled" \
    --argjson autostart "$as" --argjson folderOk "$fok" \
    --argjson pid "$pid" --argjson uptime "$uptime" --argjson port "$pn" \
    --argjson health "$health" --argjson portPid "$ppid" --argjson foreign "$foreign" \
    --argjson stats "$stats" --argjson days "$days" --argjson gpu "$gpu" \
    --arg version "$version" --arg layaVersion "$lver" \
    --argjson envs "$envs" --argjson agents "$(agent_wiring)" \
    '{version: $version, layaVersion: $layaVersion, env: $envs,
      installed: ($layaVersion != ""), agents: $agents,
      folder: $folder, folderOk: $folderOk, mode: $mode,
      autostart: $autostart, active: $active, sub: $sub, pid: $pid,
      enabled: $enabled, port: $port, portPid: $portPid, foreign: $foreign,
      uptime: $uptime, health: $health, stats: $stats, days: $days,
      gpu: $gpu, running: ($active == "active")}'
}

cmd_mode() {
  [[ ${1:-} == cpu || ${1:-} == gpu ]] || die "mode cpu|gpu"
  write_config "$1" "$(folder)" "$(autostart)"
  write_unit
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

cmd_folder() {
  [[ -n ${1:-} ]] || die "folder <path>"
  local f; f=$(realpath -e "$1" 2>/dev/null) || die "'$1' does not exist"
  [[ $f =~ $SAFE_PATH ]] || die "folder path '$f' has characters a systemd unit cannot carry (allowed: A-Z a-z 0-9 . _ / + @ -)"
  [[ -x $f/laya-serve ]] || die "'$f/laya-serve' is missing or not executable"
  write_config "$(mode)" "$f" "$(autostart)"
  write_unit
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

cmd_autostart() {
  [[ ${1:-} == on || ${1:-} == off ]] || die "autostart on|off"
  local as=false; [[ $1 == on ]] && as=true
  write_config "$(mode)" "$(folder)" "$as"
  write_unit  # applies enable/disable
}

cmd_start() {
  write_unit  # also validates the folder
  release_port
  rm -f "$STATS_FILE"  # fresh session counters
  systemctl --user start "$UNIT_NAME"
}

cmd_stop() {
  systemctl --user stop "$UNIT_NAME" || true
  release_port
}

# The tooling the daemon + agents need, shipped in the plugin's share/:
# the launcher, the extended HTTP server, the MCP stdio proxy, the hook
# engine, and the per-agent installer. Only files missing from the folder
# are copied — a real checkout or a user's edits are never clobbered.
sync_tools() {
  local f=$1 s
  for s in laya-serve serve.py laya-mcp.py laya-gate.py laya-mcp-install; do
    # -L: a dangling symlink fails -e but install writes through it
    [[ -e $f/$s || -L $f/$s ]] || install -m755 "$PLUGIN_DIR/share/$s" "$f/$s" || die "could not copy $s into $f"
  done
  # questions/thresholds read by laya-gate.py and laya-mcp.py
  [[ -e $f/shared.json || -L $f/shared.json ]] || install -m644 "$PLUGIN_DIR/share/shared.json" "$f/shared.json" \
    || die "could not copy shared.json into $f"
}

# Install exactly the hash-locked package set into <folder>/.venv. uv when
# present, pip otherwise; both refuse any artifact whose sha256 is not in the
# lock, any unpinned transitive dependency, and any source build (build
# backends would be fetched outside the lock). Reinstalling every package puts
# even already-present ones — e.g. from an older, unlocked install — back
# through the hash check.
install_locked() {
  local f=$1
  [[ -f $LOCK ]] || die "missing $LOCK"
  if command -v uv >/dev/null 2>&1; then
    uv pip install --python "$f/.venv/bin/python" --require-hashes --no-build --reinstall -r "$LOCK"
  else
    "$f/.venv/bin/pip" install --require-hashes --only-binary :all: --force-reinstall -r "$LOCK"
  fi
}

# Bootstrap laya into the configured folder: venv + the locked laya[serve] +
# mcp set + the laya-serve script and MCP tooling this unit expects.
cmd_install() {
  local f; f=$(folder)
  [[ $f =~ $SAFE_PATH ]] || die "folder path '$f' has characters a systemd unit cannot carry (allowed: A-Z a-z 0-9 . _ / + @ -)"
  mkdir -p "$f"
  if [[ ! -x $f/.venv/bin/python ]]; then
    if command -v uv >/dev/null 2>&1; then
      (cd "$f" && uv venv .venv) || die "venv creation failed"
    else
      python3 -m venv "$f/.venv" || die "venv creation failed"
    fi
  fi
  install_locked "$f" || die "laya install failed"
  sync_tools "$f"
  write_config "$(mode)" "$f" "$(autostart)"
  write_unit
  local after; after=$(laya_version "$f")
  echo "local-laya: installed laya ${after:-?} into $f"
}

# Wire the laya MCP proxy + hooks into every installed agent. The folder's
# laya-mcp-install does the real work (idempotent); its report is kept in
# agents.txt so the widget can show what ran last.
cmd_agents() {
  local f; f=$(folder)
  [[ -x $f/laya-mcp-install ]] || die "'$f/laya-mcp-install' is missing — run 'install' or sync the tooling"
  [[ -L $STATE_DIR/agents.txt ]] && die "$STATE_DIR/agents.txt is a symlink — refusing to write through it"
  (cd "$f" && ./laya-mcp-install "$@") 2>&1 | tee "$STATE_DIR/agents.txt"
}

# Restore the locked package set in the folder's venv (the same install as
# `install`), refresh any missing tooling, and restart a running daemon.
cmd_update() {
  local f; f=$(folder)
  [[ -x $f/.venv/bin/python ]] || die "no venv in '$f' — run 'install' first"
  local before; before=$(laya_version "$f")
  install_locked "$f" || die "update failed"
  sync_tools "$f"
  local after; after=$(laya_version "$f")
  echo "local-laya: laya ${before:-?} -> ${after:-?}"
  if [[ $(active) == active ]]; then systemctl --user restart "$UNIT_NAME"; fi
}

# laya version from the folder's venv metadata — no python spawn
laya_version() {
  local meta; meta=$(find "$1/.venv/lib" -maxdepth 4 -name "METADATA" \
    -path "*laya-*.dist-info*" 2>/dev/null | head -1)
  [[ -n $meta ]] && sed -n 's/^Version: *//p' "$meta" | head -1
}

# get/set a LAYA_* key in <folder>/laya.env. Values are one line of data:
# the file is rewritten via temp + rename, never through sed or a shell.
cmd_env() {
  local f; f=$(folder)
  local envf="$f/laya.env"
  if [[ -z ${1:-} ]]; then
    [[ -f $envf ]] && cat "$envf" || true
    return 0
  fi
  local key="${1%%=*}"
  [[ $key =~ ^LAYA_[A-Z0-9_]+$ ]] || die "env key must be LAYA_*"
  if [[ $1 != *=* ]]; then  # bare key: print current value
    sed -n "s/^ *${key} *=//p" "$envf" 2>/dev/null || true
    return 0
  fi
  local val="${1#*=}" tmp
  [[ $val != *[$'\n\r']* ]] || die "env value must be a single line"
  tmp=$(mktemp "$f/.laya.env.XXXXXX") || die "mktemp failed"
  { grep -v "^ *${key} *=" "$envf" 2>/dev/null; printf '%s=%s\n' "$key" "$val"; } > "$tmp" &&
    mv -f "$tmp" "$envf" || { rm -f "$tmp"; die "failed to write $envf"; }
  echo "local-laya: $key set (applies on next start)"
  if [[ $(active) == active ]]; then
    echo "local-laya: restarting to apply"
    systemctl --user restart "$UNIT_NAME"
  fi
}

case "${1:-}" in
  snapshot)  snapshot ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   write_unit; release_port; systemctl --user restart "$UNIT_NAME" ;;
  mode)      cmd_mode "${2:-}" ;;
  folder)    cmd_folder "${2:-}" ;;
  autostart) cmd_autostart "${2:-}" ;;
  update)    cmd_update ;;
  install)   cmd_install ;;
  agents)    shift; cmd_agents "$@" ;;
  env)       shift; cmd_env "$@" ;;
  log)       exec omarchy-launch-tui --app-id=org.omarchy.local-laya-log \
               journalctl --user -fu "$UNIT_NAME" ;;
  *)         die "snapshot | start | stop | restart | mode cpu|gpu | folder <path> | autostart on|off | install | update | agents [agent...] | env [LAYA_*=v] | log" ;;
esac
